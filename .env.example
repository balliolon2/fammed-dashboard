# Database (Neon Serverless PostgreSQL connection string)
# e.g. postgresql://user:password@ep-sample-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth Configuration
# For local development: http://localhost:3000
# For production on Vercel: https://your-project.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-generated-random-nextauth-secret-here"

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Demo Mode Configuration
# Set to "true" to display the quick clinician switcher (OPD mode) on the login page
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="true"
